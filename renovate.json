{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitType(chore)"
  ],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(all): ",
  "postUpdateOptions": ["gomodTidy"],
  "enabledManagers": ["gomod", "github-actions", "dockerfile", "mise"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "prConcurrentLimit": 50,
  "prHourlyLimit": 0,
  "ignoreTests": false,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "description": "Group Go module updates",
      "matchManagers": ["gomod"],
      "groupName": "go modules"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Bump the Go version together across go.mod, .mise.toml and the Dockerfile",
      "matchManagers": ["gomod", "mise", "dockerfile"],
      "matchDepNames": ["go", "golang"],
      "groupName": "go version"
    },
    {
      "description": "Let major updates soak before automerge",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
