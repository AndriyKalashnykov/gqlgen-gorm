# Committed defaults (source of truth). Copy to `.env` to override locally.
# `.env` is gitignored. Shell scripts and the Makefile read these with
# `?=` / `${VAR:-default}` fallbacks, so they work without a `.env` file.

# GraphQL server bind/connect address (used by `make run` and the todo-* curl recipes).
GQL_HOST=localhost
GQL_PORT=4000

# SQLite data source name used by the server. Tests override this with a temp DB.
DB_DSN=dev.db
